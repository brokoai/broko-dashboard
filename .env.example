# Supabase (create a NEW Broko project; do not reuse other projects)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Not used by Phase 1 code; reserved for the later n8n/AI worker.
# Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local demo only: fake sign-in + in-memory data when Supabase is NOT configured.
# Ignored in production builds.
BROKO_DEMO_MODE=false
