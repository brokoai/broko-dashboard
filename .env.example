# --- Real backend (future). Names only; no values in this file. -----------------
# If ANY Supabase variable is set (any SUPABASE_* / NEXT_PUBLIC_SUPABASE_* name, or the Supabase
# integration's POSTGRES_URL variables), demo mode is impossible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Not used by Phase 1 code; reserved for the later n8n/AI worker.
# Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode (synthetic data, no real backend, no password) --------------------
# Local development: set only this one.
BROKO_DEMO_MODE=false
# A public/production demo (e.g. Vercel) additionally needs BOTH of these. Set them as
# server-side environment variables in the hosting dashboard. Never commit a value, never use
# a NEXT_PUBLIC_ prefix.
BROKO_ALLOW_PRODUCTION_DEMO=false
# Random secret that signs the demo cookies so they cannot be forged. At least 32 characters
# from a CSPRNG, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every demo visitor out.
BROKO_DEMO_SESSION_SECRET=

# BROKO_DEMO_ACCESS_CODE is no longer used (the demo has no access code). If it is still set in
# your hosting dashboard it is ignored and can be deleted.

# --- AI Brain, Communication Agent (Phase 1). Names only; no values in this file. -------------
# Nothing here is required for the demo. Unset = the agent runs on the deterministic rule-based
# classifier and every proposed task waits for a human. All are SERVER-ONLY: never prefix with
# NEXT_PUBLIC_, never commit a value, set them in the hosting dashboard.
# Language-model key for classification. Create it under the ORGANISATION's Anthropic account.
ANTHROPIC_API_KEY=
# "rules" (default) or "llm". The model is used only when this is "llm" AND ANTHROPIC_API_KEY is set;
# if the model is unavailable or returns invalid output, messages fall back to the rules (and say so).
BROKO_AI_CLASSIFIER=
# "rules" (default) or "llm". When "llm" AND ANTHROPIC_API_KEY is set, a model only CHOOSES which read-only question the floating
# chat answers for sentences the keyword router did not understand. Same key and model as the classifier. Never answers or reads.
# In production it is ignored (fail closed) unless the durable limiter below is configured; the in-memory limit only protects a single local process.
BROKO_AI_CHAT=
# Durable shared model budget: any Redis-compatible REST store (Upstash, Vercel Marketplace Redis). https only. The Vercel integration's
# KV_REST_API_URL / KV_REST_API_TOKEN names are also accepted. Any store error means no model call (deterministic chat).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional ceilings: model calls per user per 10 minutes (default 20) and in total per 24 hours (default 200).
BROKO_AI_CHAT_USER_MAX=
BROKO_AI_CHAT_GLOBAL_MAX=
# Shared demo code that switches on AI (paid model) mode in the chat. Server-side only; at least 12 characters; unset or shorter = AI mode stays off.
# Unlocking sets a signed, user-bound cookie for 2 hours and needs the shared store above to count attempts (5 per client per 15 min, 30 in total per hour).
BROKO_AI_DEMO_CODE=
BROKO_AI_MODEL=
# JSON, validated at startup; invalid values fall back to the strictest defaults.
# See docs/ai-brain/SECURITY_AND_SETUP.md for the shapes.
BROKO_AI_POLICY=
BROKO_AI_OWNER_RULES=
# Email providers (adapters not built yet). Register the OAuth application under the
# organisation's tenant, with read-only scopes on explicitly selected mailboxes.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
