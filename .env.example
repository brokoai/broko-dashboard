# --- Real backend (future). Names only; no values in this file. -----------------
# If ANY Supabase variable is set (any SUPABASE_* / NEXT_PUBLIC_SUPABASE_* name, or the Supabase
# integration's POSTGRES_URL variables), demo mode is impossible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Not used by Phase 1 code; reserved for the later n8n/AI worker.
# Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode (synthetic data, no real backend) ---------------------------------
# Local development: set only this one.
BROKO_DEMO_MODE=false
# A public/production demo (e.g. Vercel) additionally needs ALL THREE of these. Set them as
# server-side environment variables in the hosting dashboard. Never commit a value, never use
# a NEXT_PUBLIC_ prefix.
BROKO_ALLOW_PRODUCTION_DEMO=false
# Shared code people type to enter the demo. At least 12 characters. Changing it signs everyone out.
BROKO_DEMO_ACCESS_CODE=
# Random secret that signs the demo cookies. At least 32 characters from a CSPRNG, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Different from the access code. Rotating it signs everyone out.
BROKO_DEMO_SESSION_SECRET=

# Only if you self-host behind your OWN reverse proxy that sets x-real-ip / appends to
# x-forwarded-for: lets rate limiting see client IPs. Leave unset on Vercel (detected automatically).
BROKO_TRUST_PROXY=
